# ==========================================
# BREWPOINT POS - ENVIRONMENT VARIABLES
# ==========================================

# 1. DATABASE_URL
# Untuk Local Development (SQLite):
# DATABASE_URL="file:./dev.db"
#
# Untuk Production di Vercel (Neon PostgreSQL Serverless):
DATABASE_URL="postgresql://username:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. CAPACITOR_SERVER_URL (Opsional)
# URL Vercel untuk aplikasi Android APK:
CAPACITOR_SERVER_URL="https://brewpoint-pos.vercel.app"

# 3. NEXT_PUBLIC_GITHUB_REPO (Untuk link download APK otomatis)
NEXT_PUBLIC_GITHUB_REPO="azidnaim-blip/undangan-pernikahan"
